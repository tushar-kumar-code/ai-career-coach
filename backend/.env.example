# Application Environment Settings
PROJECT_NAME="AI Career Coach API"
API_V1_STR="/api/v1"
DEBUG=False
ENVIRONMENT="production"

# CORS Configuration (comma separated origins for production frontend)
BACKEND_CORS_ORIGINS=["https://your-frontend-app.vercel.app","http://localhost:3000"]

# Database Configuration (PostgreSQL / Supabase asyncpg)
DATABASE_URL="postgresql+asyncpg://postgres:your_password@your_supabase_host:5432/postgres"

# Security & Auth
SECRET_KEY="replace_with_a_secure_random_64_char_secret_key_in_production"
SUPABASE_URL="https://your_project.supabase.co"
SUPABASE_ANON_KEY="your_supabase_anon_key"
SUPABASE_JWT_SECRET="your_supabase_jwt_secret"

# AI Provider Settings
AI_PROVIDER="groq"  # groq, gemini, openai, anthropic
GROQ_API_KEY="your_groq_api_key_here"
GROQ_MODEL="openai/gpt-oss-120b"
GEMINI_API_KEY="your_gemini_api_key_here"
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

